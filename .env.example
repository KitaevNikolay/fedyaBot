PORT=3000
BOT_PORT=3000
CABINET_PORT=3001
# Bot API Яндекс Мессенджера (OAuth-токен бота из Яндекс 360 → Мессенджер → Боты)
YANDEX_BOT_TOKEN=
# Публичный URL вебхука; пусто — бот сам опрашивает getUpdates (polling)
YANDEX_WEBHOOK_URL=
DATABASE_URL="mysql://fedya:fedya@localhost:3306/fedya"
MYSQL_DATABASE=fedya
MYSQL_USER=fedya
MYSQL_PASSWORD=fedya
MYSQL_ROOT_PASSWORD=fedya_root
REDIS_HOST=redis
REDIS_PORT=6379
BOTHUB_API_KEY=
TEXT_RU_API_KEY=
OUTLINE_API_URL="https://outline.rilokobotfactory.ru/api"
OUTLINE_API_KEY=
OUTLINE_MIGRATE_ON_START=false
# Коллекция Outline с промптами для списка в кабинете (имя или id); пусто — коллекция «prompts»
OUTLINE_PROMPTS_COLLECTION=
LOG_FILE_PATH=logs/app.log
BITRIX_WEBHOOK=
BOTHUB_MOCK_MODE=false
CABINET_AUTH_SECRET=
# Логины Яндекса, которые получают роль admin автоматически (через запятую)
CABINET_ADMIN_LOGINS=
CABINET_HOST=
